{
  "name": "@venlyfinance/sdk",
  "version": "0.8.0",
  "description": "TypeScript SDK for the Venly Finance and Fundflow APIs. Generated from the OpenAPI specs, zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "specs/*.yaml",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "openapi-typescript specs/finance.yaml -o src/generated/finance.ts && openapi-typescript specs/fundflow.yaml -o src/generated/fundflow.ts && node scripts/generate-mock-shapes.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/fix-cjs.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.esm.json --noEmit"
  },
  "keywords": [
    "venly",
    "stablecoin",
    "settlement",
    "payments",
    "sdk",
    "openapi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Venly/venly-settlement-sdk"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "homepage": "https://github.com/Venly/venly-settlement-sdk#readme",
  "bugs": {
    "url": "https://github.com/Venly/venly-settlement-sdk/issues"
  }
}
