{
  "name": "@venlyfinance/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Copy-owned UI kit for Venly-powered money products: design tokens (the white-label contract) plus components implementing measured fintech density, money typography, and state-legibility rules. Distributed via the shadcn registry standard, not npm.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.tsx",
    "build:registry": "node scripts/build-registry.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-one-time-password-field": "^0.1.16",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@venlyfinance/react": "^0.1.1",
    "@venlyfinance/sdk": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venly/venly-settlement-sdk.git",
    "directory": "ui"
  }
}
