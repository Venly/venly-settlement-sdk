{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext"
  },
  "include": [
    "registry/**/*.ts",
    "registry/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "demo/**/*.tsx"
  ]
}
