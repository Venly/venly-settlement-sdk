# Credentials for the staging/qa smoke test (scripts/staging-smoke.mjs).
# Copy to .env and fill in; .env is gitignored and must never be committed.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   VENLY_ENV=qa node scripts/staging-smoke.mjs
#
# The pair is an OAuth2 client-credentials client on the VenlyFinance realm
# (login-qa.venly.io for qa, login-staging.venly.io for staging).
VENLY_CLIENT_ID=
VENLY_CLIENT_SECRET=
# qa | staging (default staging). qa serves the leading contract (1.3.0).
VENLY_ENV=qa
